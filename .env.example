# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA (EJÉRCITO ARGENTINO - B MANT COM 601)
# ==============================================================================
APP_ENV=development  # production, development, testing
APP_DEBUG=True
API_PORT=8000
SECRET_KEY=cambiar_por_un_hash_seguro_en_produccion

# ==============================================================================
# BASE DE DATOS VECTORIAL (MOTOR RAG)
# ==============================================================================
# Usaremos Qdrant localizado en nuestro propio contenedor de Docker
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY= 123456

# ==============================================================================
# BASE DE DATOS RELACIONAL (STOCK DE EFECTOS ELECTRÓNICOS Y LOGS)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ea_logistica_db
DB_USER=postgres_ea
DB_PASSWORD= bmantcom601

# ==============================================================================
# INTELIGENCIA ARTIFICIAL (LLM / EMBEDDINGS) - 100% LOCAL Y OPEN SOURCE
# ==============================================================================
# toda la inferencia se procesará dentro de la máquina virtual de la nube del EA.
LLM_PROVIDER=ollama         # Opciones gratuitas: ollama o huggingface_local
LLM_MODEL=llama3:8b         # Modelo open-source gratuito ejecutado en el servidor EA
EMBEDDING_MODEL=all-minilm  # Modelo de embedding ultraligero y gratis (ejecutado en CPU/GPU local)

# OLLAMA HOST (IP/Host de la máquina virtual donde corre Ollama en la nube del EA)
OLLAMA_HOST=http://localhost:11434

# ==============================================================================
# PARÁMETROS LOGÍSTICOS Y ALERTAS (REQUERIMIENTO HU5 / HU7)
# ==============================================================================
UMBRAL_ALERTA_TIEMPO=0.10  # 10% de desvío sobre el tiempo estimado de reparación
EMAIL_NOTIFICACIONES=logistica.bmantcom601@ejercito.mil.ar